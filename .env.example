# Copy to .env.local and fill in.
# None of these are ever sent to the browser — they are read only inside
# the API routes, which run on the server.

# Where the model lives. No trailing slash.
# llama.cpp defaults to 8080, Ollama to 11434, LM Studio to 1234.
LLM_URL=http://192.168.50.137:8080

# Only if you started llama-server with --api-key. Leave blank otherwise.
LLM_API_KEY=

# Shown in the header and used as the default selection.
LLM_DEFAULT_MODEL=

# Prepended to every conversation.
LLM_SYSTEM_PROMPT=You are a helpful assistant running on a home server. Be direct and concise.
